# Canonical reference for AG2CLI environment variables: docs/user/configuration.md
# Copy this file to .env and add your values; .env is ignored by .gitignore.
# AG2CLI does not manage model providers; configure your provider or local endpoint.

AG2CLI_PROTOCOL=anthropic
AG2CLI_BASE_URL=https://your-provider.example.com/v1
AG2CLI_API_KEY=sk-your-key-here
AG2CLI_MODEL=your-model-name
# Preferred model response language; defaults to the system locale.
# AG2CLI_RESPONSE_LANGUAGE=zh-CN
# TUI project instructions; defaults to AGENTS.md and accepts one basename.
# AG2CLI_INSTRUCTIONS_FILE=CLAUDE.md
